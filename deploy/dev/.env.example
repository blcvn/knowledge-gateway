# =============================================================================
# knowledge-graph-service — Dev Environment Variables
# Copy this file to .env and fill in the values before running docker compose.
# =============================================================================

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# KG_HTTP_HOST=0.0.0.0
# KG_HTTP_PORT=8082

# ---------------------------------------------------------------------------
# Embedding provider
# Provider: deterministic | http
#
# deterministic — hash-based 8-dim vector. For dev/test only; no real semantics.
# http          — any OpenAI-compatible REST endpoint (OpenAI, Ollama, vLLM …)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=deterministic
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_PROXY_URL=
# Cache embeddings in-memory (seconds). 0 = disabled.
EMBEDDING_CACHE_TTL_S=0
# Vector dimension the provider returns.
# Required for VECTOR_ADAPTER=pgvector HNSW indexing.
# Common values: 8 (deterministic), 1536 (text-embedding-3-small),
#                3072 (text-embedding-3-large), 768 (nomic-embed-text).
EMBEDDING_DIMENSIONS=0

# Per-tenant provider override (JSON map).  Leave empty for single provider.
# Example:
#   EMBEDDING_TENANT_ROUTES={"tenant-uuid-1":{"provider":"http","url":"https://api.openai.com/v1/embeddings","model":"text-embedding-3-large","api_key":"sk-...","dimensions":3072}}
EMBEDDING_TENANT_ROUTES=

# Per-domain provider override (JSON map).  Leave empty for single provider.
# Example:
#   EMBEDDING_DOMAIN_ROUTES={"legal-domain":{"provider":"http","url":"http://ollama:11434/api/embeddings","model":"nomic-embed-text","dimensions":768}}
EMBEDDING_DOMAIN_ROUTES=

# ---------------------------------------------------------------------------
# Vector adapter
# Kind: memory | pgvector | qdrant | milvus
#
# memory   — in-process, lost on restart. Dev/test only.
# pgvector — persisted in Postgres (recommended for single-node deployments).
# qdrant   — external Qdrant server (high-scale production).
# milvus   — external Milvus server (high-scale production).
# ---------------------------------------------------------------------------
VECTOR_ADAPTER=pgvector
KG_VECTOR_ENDPOINT=
KG_VECTOR_COLLECTION=kg_vectors

# ---------------------------------------------------------------------------
# Graph adapter
# Kind: memory | neo4j | memgraph | nebula | surreal
#
# memory   — in-process, lost on restart. Dev/test only.
# memgraph — persistent Memgraph via Bolt (recommended for dev, bundled in compose).
# neo4j    — Neo4j Enterprise/Community (production).
# nebula   — NebulaGraph (high-scale production).
# surreal  — SurrealDB via HTTP REST API (multi-model alternative).
# ---------------------------------------------------------------------------
GRAPH_ADAPTER=memgraph
KG_GRAPH_ENDPOINT=bolt://memgraph:7687
KG_GRAPH_DATABASE=

# SurrealDB-specific (only used when GRAPH_ADAPTER=surreal)
# KG_GRAPH_ENDPOINT=http://surrealdb:8000
KG_SURREAL_NAMESPACE=kg
KG_SURREAL_USERNAME=root
KG_SURREAL_PASSWORD=root

# ---------------------------------------------------------------------------
# Full-text search (FTS) adapter
# Kind: memory | postgres
# ---------------------------------------------------------------------------
FTS_ADAPTER=postgres

# ---------------------------------------------------------------------------
# Background worker — outbox polling for vector / FTS / graph projection
# Disable when running multiple replicas and routing events externally.
# ---------------------------------------------------------------------------
KG_WORKER_ENABLED=true
KG_WORKER_POLL_INTERVAL_MS=500
