# ============================================================
# Memobase App — Environment Variables (Example for Docker Compose)
# ============================================================

# App
AUTH_DEV_MODE=true
LOG_LEVEL=info
REST_PORT=8080
MCP_PORT=8082
HEALTH_PORT=9090
SHUTDOWN_TIMEOUT=30s

# Service gRPC ports
INGESTION_GRPC_PORT=9041
ENGINE_GRPC_PORT=9042
CONTEXT_GRPC_PORT=9043
PIPELINE_GRPC_PORT=9044

# PostgreSQL (required)
DATABASE_URL=postgres://memobase:memobase@postgres:5432/memobase?sslmode=disable

# NATS
NATS_URL=nats://nats:4222
NATS_STREAM=memobase

# Redis (profile caching + rate limiting)
REDIS_ADDR=redis:6379

# LLM (required for engine — profile extraction)
LLM_PROVIDER=bifrost
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_SMALL_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Embedder (optional — vector search)
EMBEDDER_PROVIDER=openai
EMBEDDER_MODEL=text-embedding-3-small
EMBEDDING_ENABLED=true

# Auth
ROOT_ACCESS_TOKEN=

# OTel (optional)
OTEL_ENDPOINT=
