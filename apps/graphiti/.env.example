# ============================================================
# Graphiti App — Environment Variables (Example for Docker Compose)
# ============================================================

# App
AUTH_DEV_MODE=true
LOG_LEVEL=info
REST_PORT=8080
MCP_PORT=8082
HEALTH_PORT=9090
SHUTDOWN_TIMEOUT=30s

# Service gRPC ports
INGESTION_GRPC_PORT=9021
SEARCH_GRPC_PORT=9022
KNOWLEDGE_GRPC_PORT=9023
STORE_GRPC_PORT=9024
PIPELINE_GRPC_PORT=9025

# PostgreSQL (optional — gateway key store)
POSTGRES_DSN=

# NATS
NATS_URL=nats://nats:4222
NATS_STREAM=graphiti

# Neo4j (graph database)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Redis (search cache)
REDIS_ADDR=redis:6379

# LLM
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_SMALL_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Embedder
EMBEDDER_PROVIDER=openai
EMBEDDER_MODEL=text-embedding-3-small

# Reranker
RERANKER_PROVIDER=openai
RERANKER_MODEL=gpt-4o-mini

# OTel (optional)
OTEL_ENDPOINT=
