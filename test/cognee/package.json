{
  "name": "cognee-integration-tests",
  "version": "1.0.0",
  "description": "Integration tests for VNP Memory Cognee API",
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --forceExit",
    "test:health": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --testPathPattern='01-health'",
    "test:auth": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --testPathPattern='02-auth'",
    "test:datasets": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --testPathPattern='03-datasets'",
    "test:memory": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --testPathPattern='04-memory'",
    "test:search": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --testPathPattern='05-search'",
    "test:settings": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --testPathPattern='06-settings'",
    "test:infra": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand --testPathPattern='07-infra'"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "@jest/types": "^29.6.3"
  },
  "jest": {
    "transform": {},
    "extensionsToTreatAsEsm": [],
    "testTimeout": 30000,
    "testMatch": [
      "**/__tests__/**/*.test.mjs"
    ],
    "verbose": true
  }
}
