{
  "name": "zep-samples",
  "version": "1.0.0",
  "description": "Sample scripts demonstrating Zep context engineering platform API usage",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand --forceExit",
    "test:health": "jest --runInBand --testPathPattern='01-health'",
    "test:users": "jest --runInBand --testPathPattern='02-users'",
    "test:sessions": "jest --runInBand --testPathPattern='03-sessions'",
    "test:memory": "jest --runInBand --testPathPattern='04-memory'",
    "test:search": "jest --runInBand --testPathPattern='05-search'",
    "test:lifecycle": "jest --runInBand --testPathPattern='06-lifecycle'",
    "demo": "node scripts/demo-conversation.mjs",
    "demo:memory": "node scripts/demo-memory-retrieval.mjs",
    "demo:search": "node scripts/demo-graph-search.mjs"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "@jest/types": "^29.6.3"
  },
  "jest": {
    "transform": {},
    "testTimeout": 60000,
    "testMatch": [
      "**/__tests__/**/*.test.mjs"
    ],
    "verbose": true
  }
}
