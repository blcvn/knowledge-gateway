###############################################################################
# Graphiti Sample Configuration
# Copy this file to .env and adjust the URL to match your deployment:
#   cp .env.example .env
###############################################################################

# Graphiti API endpoint (via nginx reverse proxy)
GRAPHITI_API_URL=https://c6.openledger.vn/graphiti

# Direct access (when running on the same network as the dev server)
# GRAPHITI_API_URL=http://172.20.2.39:8001

# Timeouts (seconds)
REQUEST_TIMEOUT=30
LONG_TIMEOUT=120

# Default group ID for samples (isolates sample data from production)
SAMPLE_GROUP_ID=sample-graphiti-demo
