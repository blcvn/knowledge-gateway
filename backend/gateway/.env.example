# VNP Gateway — Environment Configuration
# Copy to .env and customize for your environment

# ─── Server ─────────────────────────────────────
REST_PORT=8080
GRPC_PORT=8081
MCP_PORT=8082
HEALTH_PORT=11080
SHUTDOWN_TIMEOUT=30s
LOG_LEVEL=info
LOG_FORMAT=json

# ─── Auth ────────────────────────────────────────
AUTH_DEV_MODE=true
# AUTH_JWT_PUBLIC_KEY=/path/to/public.pem
AUTH_JWT_ISSUER=vnp-memory
AUTH_JWT_AUDIENCE=vnp-api
AUTH_API_KEY_PREFIX=vnp_

# ─── PostgreSQL ──────────────────────────────────
POSTGRES_DSN=postgres://vnp:vnp@postgres:5432/vnp_gateway?sslmode=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=5

# ─── Redis ───────────────────────────────────────
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Rate Limiting ───────────────────────────────
RATELIMIT_ENABLED=true
RATELIMIT_FREE_RPM=60
RATELIMIT_PRO_RPM=600
RATELIMIT_ENTERPRISE_RPM=6000

# ─── Circuit Breaker ────────────────────────────
CB_MAX_FAILURES=5
CB_TIMEOUT=60s
CB_MAX_REQUESTS=3

# ─── Timeouts ───────────────────────────────────
TIMEOUT_DEFAULT=30s
TIMEOUT_INGESTION=120s
TIMEOUT_SEARCH=10s
TIMEOUT_MCP=300s

# ─── CORS ────────────────────────────────────────
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# ─── Observability ───────────────────────────────
OTEL_ENDPOINT=otel-collector:4317
OTEL_SERVICE_NAME=vnp-gateway
METRICS_ENABLED=true

# ─── NATS ────────────────────────────────────────
NATS_URL=nats://nats:4222
# NATS_CREDS_FILE=/path/to/nats.creds
