# =============================================================================
# Cognee App — Environment Variables
# =============================================================================
# Copy to .env and customize for your environment.
# Used by docker-compose and local development.

# ── App Settings ─────────────────────────────────────────────────────────
AUTH_DEV_MODE=true
LOG_LEVEL=info
REST_PORT=8080
HEALTH_PORT=11080
SHUTDOWN_TIMEOUT=30s

# ── Embedded Service gRPC Ports ──────────────────────────────────────────
INGESTION_GRPC_PORT=9011
COGNIFY_GRPC_PORT=9012
SEARCH_GRPC_PORT=9013

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql://postgres:password@postgres:5432/cognee?sslmode=disable

# ── NATS JetStream ───────────────────────────────────────────────────────
NATS_URL=nats://nats:4222
NATS_STREAM=cognee

# ── Neo4j ────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# ── Qdrant ───────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=cognee

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_ADDR=redis:6379

# ── MinIO (S3-compatible) ────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cognee

# ── LLM ──────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small
LLM_BASE_URL=

# ── Observability (Optional) ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
