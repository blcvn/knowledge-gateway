# Supermemory Application Environment Variables
# These match the unified configuration defined in apps/supermemory/internal/config/config.go

# --- Service Ports ---
SM_DOCUMENT_PORT=9001
SM_MEMORY_PORT=9002
SM_SEARCH_PORT=9003
SM_PROFILE_PORT=9004
SM_CONNECTOR_PORT=9005
SM_MCP_PORT=9006
SM_AUTH_PORT=9007
SM_ANALYTICS_PORT=9008
SM_PROJECT_PORT=9009
SM_ENGINE_PORT=9010
GATEWAY_PORT=8080

# --- Infrastructure ---
DATABASE_URL="postgres://supermemory:supermemory@localhost:5432/supermemory?sslmode=disable"
REDIS_ADDR="localhost:6379"
NATS_URL="nats://localhost:4222"

# --- Security ---
JWT_SECRET="replace_with_a_secure_random_string"
API_KEY="replace_with_master_api_key"
