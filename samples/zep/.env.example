###############################################################################
# Zep Sample Configuration
# Copy this file to .env and adjust values for your deployment:
#   cp .env.example .env
###############################################################################

# Zep API endpoint (via nginx reverse proxy)
ZEP_API_URL=https://c6.openledger.vn/zep

# Direct access (when running on the same network as the dev server)
# ZEP_API_URL=http://172.20.2.39:8002

# Zep API key (leave empty if auth is disabled)
ZEP_API_KEY=

# Timeouts (seconds)
REQUEST_TIMEOUT=30
LONG_TIMEOUT=120

# Default test user/session prefix (isolates sample data from production)
SAMPLE_USER_PREFIX=sample-zep
SAMPLE_SESSION_PREFIX=sample-session
